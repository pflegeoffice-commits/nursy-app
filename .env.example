# ============================================================
#  Nursy – Umgebungsvariablen für Hetzner
#  Kopieren als: /opt/nursy/.env
#  Werte anpassen – diese Datei NICHT in Git einchecken!
# ============================================================

# Datenbank (PostgreSQL)
DATABASE_URL=postgresql://nursy_user:DEIN_DB_PASSWORT@localhost:5432/nursy

# Admin / Admiral Passwort (Login auf admin.html)
ADMIN_PASSWORD=DEIN_ADMIRAL_PASSWORT

# Session-Verschlüsselung (beliebiger langer zufälliger String)
SESSION_SECRET=nursy-hetzner-secret-AENDERN-2024

# E-Mail (SMTP) für Passwort-Reset und Benachrichtigungen
SMTP_HOST=mail.akutplus.at
SMTP_PORT=587
SMTP_USER=pflege@akutplus.at
SMTP_PASS=DEIN_MAIL_PASSWORT
SMTP_FROM=pflege@akutplus.at
